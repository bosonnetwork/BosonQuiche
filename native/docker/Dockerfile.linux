# Minor versions float within the major release; glibc stays at 2.28.
FROM almalinux:8

ARG TARGETARCH
RUN dnf install -y \
    gcc-toolset-14-gcc-14.2.1-11.el8_10 gcc-toolset-14-gcc-c++-14.2.1-11.el8_10 \
    clang-devel-22.1.8-2.module_el8.10.0+4359+f07421b9 \
    llvm-22.1.8-2.module_el8.10.0+4359+f07421b9 cmake \
    python39-3.9.25-2.module_el8.10.0+4083+53cad1fb \
    make perl-core git patch curl xz \
    && rpm -qa | sort > /opt/build-packages.txt \
    && dnf clean all \
    && ln -s /usr/bin/python3.9 /usr/local/bin/python3

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/opt/rh/gcc-toolset-14/root/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV CC=gcc CXX=g++ LIBCLANG_PATH=/usr/lib64
ARG RUST_TOOLCHAIN=stable
RUN case "$TARGETARCH" in \
      arm64) host=aarch64-unknown-linux-gnu; sha=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c ;; \
      amd64) host=x86_64-unknown-linux-gnu; sha=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c ;; \
      *) exit 1 ;; \
    esac \
    && curl -fsSL "https://static.rust-lang.org/rustup/archive/1.28.2/$host/rustup-init" -o /tmp/rustup-init \
    && echo "$sha  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
    && rm /tmp/rustup-init

RUN rustup component add llvm-tools

# Install the JDK's bundled Linux JNI headers. Record the resolved package
# versions in the image inventory instead of pinning individual header bytes.
RUN dnf install -y java-17-openjdk-devel \
    && rpm -qa | sort > /opt/build-packages.txt \
    && dnf clean all
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk
WORKDIR /work
