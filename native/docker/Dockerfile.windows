FROM ubuntu:24.04

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils python3 git patch build-essential \
    clang-20 llvm-20 \
    libclang-20-dev lld-20 \
    cmake ninja-build nasm \
    && dpkg-query -W > /opt/build-packages.txt \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/usr/lib/llvm-20/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ARG RUST_TOOLCHAIN=stable
RUN case "$TARGETARCH" in \
      arm64) host=aarch64-unknown-linux-gnu; sha=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c ;; \
      amd64) host=x86_64-unknown-linux-gnu; sha=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c ;; \
      *) exit 1 ;; \
    esac \
    && curl -fsSL "https://static.rust-lang.org/rustup/archive/1.28.2/$host/rustup-init" -o /tmp/rustup-init \
    && echo "$sha  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
    && rustup target add x86_64-pc-windows-msvc aarch64-pc-windows-msvc \
    && rm /tmp/rustup-init

RUN case "$TARGETARCH" in \
      arm64) host=aarch64-unknown-linux-musl; sha=dc0a0fb28fdd90405f69e7365bce91d2504ea7491eb4d79d5655ffa106358925 ;; \
      amd64) host=x86_64-unknown-linux-musl; sha=c492c6dfb7e5ac0eee586b796e0fc950ba13077e7f0bbb046f445d71790d5360 ;; \
      *) exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/rust-cross/cargo-xwin/releases/download/v0.23.1/cargo-xwin-v0.23.1.$host.tar.gz" -o /tmp/xwin.tar.gz \
    && echo "$sha  /tmp/xwin.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/xwin.tar.gz -C /opt/cargo/bin \
    && rm /tmp/xwin.tar.gz

ENV LIBCLANG_PATH=/usr/lib/llvm-20/lib
RUN rustup component add llvm-tools

# A Windows JDK supplies the target JNI definitions for both MSVC architectures.
# Keep its bundled headers and provenance; its Windows executables are not run.
ARG WINDOWS_JDK_VERSION=17.0.17
ARG WINDOWS_JDK_BUILD=10
RUN name="OpenJDK17U-jdk_x64_windows_hotspot_${WINDOWS_JDK_VERSION}_${WINDOWS_JDK_BUILD}.zip" \
    && url="https://github.com/adoptium/temurin17-binaries/releases/download/jdk-${WINDOWS_JDK_VERSION}%2B${WINDOWS_JDK_BUILD}/$name" \
    && curl -fsSL --retry 3 "$url" -o /tmp/windows-jdk.zip \
    && curl -fsSL --retry 3 "$url.sha256.txt" -o /tmp/windows-jdk.sha256 \
    && echo "$(cut -d ' ' -f 1 /tmp/windows-jdk.sha256)  /tmp/windows-jdk.zip" | sha256sum -c - \
    && python3 -m zipfile -e /tmp/windows-jdk.zip /tmp/windows-jdk \
    && mkdir -p /opt/windows-jdk \
    && mv "/tmp/windows-jdk/jdk-${WINDOWS_JDK_VERSION}+${WINDOWS_JDK_BUILD}/include" \
          "/tmp/windows-jdk/jdk-${WINDOWS_JDK_VERSION}+${WINDOWS_JDK_BUILD}/release" \
          "/tmp/windows-jdk/jdk-${WINDOWS_JDK_VERSION}+${WINDOWS_JDK_BUILD}/legal" /opt/windows-jdk/ \
    && rm -rf /tmp/windows-jdk /tmp/windows-jdk.zip /tmp/windows-jdk.sha256
ENV JAVA_HOME=/opt/windows-jdk
WORKDIR /work
