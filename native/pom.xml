<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.bosonnetwork</groupId>
        <artifactId>boson-quiche-parent</artifactId>
        <version>0.30.1.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>boson-quiche-native</artifactId>
    <packaging>pom</packaging>
    <name>Boson Quiche Desktop Natives</name>
    <description>Prebuilt desktop JNI libraries for BosonQuiche.</description>
    <url>https://github.com/bosonnetwork/BosonQuiche</url>
    <properties>
        <!-- Maven drives CMake; CMake decides what native code is built. -->
        <native.skip>false</native.skip>
        <native.skipIfEmpty>true</native.skipIfEmpty>
    </properties>
    <build>
        <plugins>
            <!-- Host build: configure, compile and install with CMake, which also
                 drives Cargo for the pinned quiche archive. No Python involved. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>cmake-configure</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${native.skip}</skip>
                            <executable>cmake</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>--preset</argument>
                                <argument>${native.preset}</argument>
                                <argument>-B</argument>
                                <argument>${project.build.directory}/cmake</argument>
                                <argument>-DCMAKE_INSTALL_PREFIX=${project.build.directory}/native-install</argument>
                                <argument>-DJNI_INCLUDE=${java.home}/include</argument>
                                <argument>-DQUICHE_SOURCE=${quiche.source}</argument>
                                <argument>-DBOSON_BINDING_ABI=${quiche.binding.abi}</argument>
                                <argument>-DBOSON_BINDING_VERSION=${project.version}</argument>
                            </arguments>
                            <environmentVariables>
                                <CMAKE_BUILD_PARALLEL_LEVEL>4</CMAKE_BUILD_PARALLEL_LEVEL>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-build</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${native.skip}</skip>
                            <executable>cmake</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>--build</argument>
                                <argument>${project.build.directory}/cmake</argument>
                                <argument>--parallel</argument>
                                <argument>4</argument>
                            </arguments>
                            <environmentVariables>
                                <CMAKE_BUILD_PARALLEL_LEVEL>4</CMAKE_BUILD_PARALLEL_LEVEL>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cmake-install</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${native.skip}</skip>
                            <executable>cmake</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>--install</argument>
                                <argument>${project.build.directory}/cmake</argument>
                                <argument>--prefix</argument>
                                <argument>${project.build.directory}/native-install</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Package exactly what the host build just installed. The clean step
                 prevents resources from an earlier distribution build leaking in. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-native-resources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/native-resources</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>host-native-resources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/native-resources/${native.classifier}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/native-install</directory>
                                    <includes>
                                        <include>native/${native.classifier}/**</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>host-native-notices</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/native-resources/${native.classifier}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/notices</directory>
                                    <targetPath>META-INF/boson-quiche-native/${native.classifier}/licenses</targetPath>
                                    <excludes>
                                        <exclude>notices.json</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/..</directory>
                                    <targetPath>META-INF/boson-quiche-native/${native.classifier}</targetPath>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>${native.skipIfEmpty}</skipIfEmpty>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>jar-linux-x86_64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/linux-x86_64</classesDirectory>
                            <classifier>linux-x86_64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-linux-aarch64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/linux-aarch64</classesDirectory>
                            <classifier>linux-aarch64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-macos-aarch64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/macos-aarch64</classesDirectory>
                            <classifier>macos-aarch64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-windows-x86_64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/windows-x86_64</classesDirectory>
                            <classifier>windows-x86_64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-windows-aarch64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/windows-aarch64</classesDirectory>
                            <classifier>windows-aarch64</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- MORE -->
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>host-macos-arm64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.preset>host-macos-arm64</native.preset>
                <native.classifier>macos-aarch64</native.classifier>
            </properties>
        </profile>
        <profile>
            <id>host-linux-amd64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <native.preset>host-linux-amd64</native.preset>
                <native.classifier>linux-x86_64</native.classifier>
            </properties>
        </profile>
        <profile>
            <id>host-linux-arm64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.preset>host-linux-arm64</native.preset>
                <native.classifier>linux-aarch64</native.classifier>
            </properties>
        </profile>
        <profile>
            <id>distribution</id>
            <activation>
                <property>
                    <name>release.directory</name>
                </property>
            </activation>
            <properties>
                <!-- Packaging comes from validated staged inputs, not the host
                     build; the host build still runs so the JNI tests and the
                     loader fixtures are available. -->
                <native.skipIfEmpty>false</native.skipIfEmpty>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>clean-native-resources</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>host-native-resources</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>host-native-notices</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-native-resources</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${project.basedir}/scripts/package_artifacts.py" />
                                            <arg value="desktop" />
                                            <arg value="--output" />
                                            <arg value="${project.build.directory}/native-resources" />
                                            <arg value="--distribution" />
                                            <arg value="true" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
