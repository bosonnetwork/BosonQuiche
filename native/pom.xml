<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.bosonnetwork</groupId>
        <artifactId>boson-quiche-parent</artifactId>
        <version>0.30.1.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>boson-quiche-native</artifactId>
    <packaging>pom</packaging>
    <name>Boson Quiche Desktop Natives</name>
    <description>Prebuilt desktop JNI libraries for BosonQuiche.</description>
    <!-- Order host native packaging after API test-resource preparation, including parallel builds. -->
    <dependencies>
        <dependency>
            <groupId>io.bosonnetwork</groupId>
            <artifactId>boson-quiche</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <url>https://github.com/bosonnetwork/BosonQuiche</url>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-native-resources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="python3" failonerror="true">
                                    <arg value="${project.basedir}/scripts/package_artifacts.py" />
                                    <arg value="desktop" />
                                    <arg value="--output" />
                                    <arg value="${project.build.directory}/native-resources" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>jar-linux-x86_64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/linux-x86_64</classesDirectory>
                            <classifier>linux-x86_64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-linux-aarch64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/linux-aarch64</classesDirectory>
                            <classifier>linux-aarch64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-macos-aarch64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/macos-aarch64</classesDirectory>
                            <classifier>macos-aarch64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-windows-x86_64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/windows-x86_64</classesDirectory>
                            <classifier>windows-x86_64</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-windows-aarch64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/native-resources/windows-aarch64</classesDirectory>
                            <classifier>windows-aarch64</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>distribution</id>
            <activation>
                <property>
                    <name>release.directory</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-native-resources</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration combine.self="override">
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${project.basedir}/scripts/package_artifacts.py" />
                                            <arg value="desktop" />
                                            <arg value="--output" />
                                            <arg value="${project.build.directory}/native-resources" />
                                            <arg value="--distribution" />
                                            <arg value="true" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
