{
  "schema": 1,
  "comment": "Single source of truth for every native target. Consumed by native_config.py, CMake and the Maven drift check.",
  "targets": [
    {
      "id": "linux-amd64",
      "rust": "x86_64-unknown-linux-gnu",
      "classifier": "linux-x86_64",
      "library": "libboson_quiche.so",
      "machine": "EM_X86_64",
      "jni": "linux",
      "baseline": "glibc 2.28",
      "android_abi": null
    },
    {
      "id": "linux-arm64",
      "rust": "aarch64-unknown-linux-gnu",
      "classifier": "linux-aarch64",
      "library": "libboson_quiche.so",
      "machine": "EM_AARCH64",
      "jni": "linux",
      "baseline": "glibc 2.28",
      "android_abi": null
    },
    {
      "id": "macos-arm64",
      "rust": "aarch64-apple-darwin",
      "classifier": "macos-aarch64",
