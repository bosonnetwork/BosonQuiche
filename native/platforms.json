      "jni": "win32",
      "baseline": "Windows 10",
      "android_abi": null
    },
    {
      "id": "windows-arm64",
      "rust": "aarch64-pc-windows-msvc",
      "classifier": "windows-aarch64",
      "library": "boson_quiche.dll",
      "machine": "IMAGE_FILE_MACHINE_ARM64",
      "jni": "win32",
      "baseline": "Windows 10",
      "android_abi": null
    }
  ]
