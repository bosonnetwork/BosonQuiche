<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.bosonnetwork</groupId>
    <artifactId>boson-quiche-parent</artifactId>
    <version>0.30.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Boson Quiche Parent</name>
    <description>Independent build and distribution for BosonQuiche.</description>
    <url>https://github.com/bosonnetwork/BosonQuiche</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>boson-network-dev</id>
            <name>Boson Network</name>
            <email>support@bosonnetwork.io</email>
            <organization>BosonNetwork</organization>
            <organizationUrl>https://github.com/bosonnetwork</organizationUrl>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/bosonnetwork/BosonQuiche.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/bosonnetwork/BosonQuiche.git</developerConnection>
        <url>https://github.com/bosonnetwork/BosonQuiche</url>
        <tag>v${project.version}</tag>
    </scm>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <quiche.version>0.30.1</quiche.version>
        <quiche.binding.abi>1</quiche.binding.abi>
        <quiche.source />
        <native.skip>false</native.skip>
        <!-- Only signing, bundling and publishing require the release gates. -->
        <release.enforce.skip>true</release.enforce.skip>
        <junit.version>5.14.4</junit.version>
        <junit.platform.version>1.14.4</junit.platform.version>
        <!-- Used implicitly by Maven archive plugins for reproducible entry timestamps. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>
    <modules>
        <module>native</module>
        <module>api</module>
    </modules>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.12.0</version>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>false</autoPublish>
                        <waitUntil>validated</waitUntil>
                        <deploymentName>BosonQuiche ${project.version}</deploymentName>
                        <failOnBuildFailure>true</failOnBuildFailure>
                        <ignorePublishedComponents>false</ignorePublishedComponents>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <defaultGoal>package</defaultGoal>
        <plugins>
            <!-- Release builds must name the prepared release explicitly. This runs
                 only for signing, bundling and publishing, and only in the
                 aggregator, so a missing or relative path fails immediately
                 instead of interpolating the literal ${release.directory}. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>release-requirements</id>
                        <inherited>false</inherited>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${release.enforce.skip}</skip>
                            <fail>true</fail>
                            <rules>
                                <requireProperty>
                                    <property>release.directory</property>
                                    <message>Signing and publishing require -Drelease.directory=&lt;absolute path&gt;.</message>
                                    <regex>^(/|[A-Za-z]:[\\/]).+$</regex>
                                    <regexMessage>release.directory must be an absolute path.</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!-- Build or validate the AAR on its own, without the full
                 staged desktop set that distribution packaging requires. -->
            <id>android</id>
            <modules>
                <module>android</module>
            </modules>
        </profile>
        <profile>
            <id>distribution</id>
            <activation>
                <property>
                    <name>release.directory</name>
                </property>
            </activation>
            <modules>
                <module>android</module>
            </modules>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>validate-native-distribution</id>
                                <inherited>false</inherited>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${project.basedir}/native/scripts/package_artifacts.py" />
                                            <arg value="validate" />
                                            <arg value="--distribution" />
                                            <arg value="true" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release-signing</id>
            <properties>
                <release.enforce.skip>false</release.enforce.skip>
            </properties>
            <activation>
                <property>
                    <name>release.directory</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>validate-prepared-release</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${maven.multiModuleProjectDirectory}/scripts/verify_release.py" />
                                            <arg value="--directory" />
                                            <arg value="${release.directory}" />
                                            <arg value="--maven-cli" />
                                            <arg value="--flag" />
                                            <arg value="skipTests=${skipTests}" />
                                            <arg value="--flag" />
                                            <arg value="maven.test.skip=${maven.test.skip}" />
                                            <arg value="--flag" />
                                            <arg value="maven.javadoc.skip=${maven.javadoc.skip}" />
                                            <arg value="--flag" />
                                            <arg value="maven.source.skip=${maven.source.skip}" />
                                            <arg value="--flag" />
                                            <arg value="gpg.skip=${gpg.skip}" />
                                            <arg value="--flag" />
                                            <arg value="skipPublishing=${skipPublishing}" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                            <!-- All package-phase attachments exist before verify-phase signing. -->
                            <execution>
                                <id>verify-release-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${maven.multiModuleProjectDirectory}/scripts/verify_release.py" />
                                            <arg value="--directory" />
                                            <arg value="${release.directory}" />
                                            <arg value="--built-module" />
                                            <arg value="${project.artifactId}" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-release-before-install</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${maven.multiModuleProjectDirectory}/scripts/verify_release.py" />
                                            <arg value="--directory" />
                                            <arg value="${release.directory}" />
                                            <arg value="--built-module" />
                                            <arg value="${project.artifactId}" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release-bundle</id>
            <properties>
                <release.enforce.skip>false</release.enforce.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-prepared-bundle</id>
                                <inherited>false</inherited>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${project.basedir}/scripts/verify_release.py" />
                                            <arg value="--directory" />
                                            <arg value="${release.directory}" />
                                            <arg value="--maven-cli" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <skipUpload>true</skipUpload>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>publish</id>
            <properties>
                <release.enforce.skip>false</release.enforce.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-release-qualification</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="python3" failonerror="true">
                                            <arg value="${maven.multiModuleProjectDirectory}/scripts/verify_release.py" />
                                            <arg value="--directory" />
                                            <arg value="${release.directory}" />
                                            <arg value="--publication" />
                                            <arg value="--maven-cli" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
